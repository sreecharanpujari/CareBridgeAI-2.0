# Discharge Care App - Environment Configuration Example

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discharge_care_db?schema=public

# Security & Authentication
JWT_SECRET=discharge_care_secure_jwt_secret_token_2026_clinical_safe

# Google Gemini AI Integration (OCR & Clinical Explanations)
GEMINI_API_KEY=your_gemini_api_key_here

# Client Environment (Vite)
VITE_API_BASE_URL=http://localhost:5000
